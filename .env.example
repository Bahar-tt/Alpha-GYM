# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
FRONTEND_ORIGIN=https://your-domain.example
# Comma-separated browser origins. Leave empty only for same-origin/CLI access.
CORS_ORIGIN=https://your-domain.example
PROVIDER_KEY=replace-with-a-long-random-provider-key
INITIAL_ADMIN_PASSWORD=replace-before-first-start
INITIAL_STAFF_PASSWORD=replace-before-first-start
ADMIN_PHONE=

# Attendance agent endpoints: keep enabled only when the agent key is configured.
AGENT_KEY=replace-with-a-long-random-agent-key
PERSONNEL_AGENT_KEY=replace-with-a-long-random-personnel-agent-key
REQUIRE_AGENT_KEY_FOR_SCANS=1

# ── Persistent storage (must match volume mount path) ─────────────────────
# On Cloudflare / Railway / Docker: mount the disk to /app/data
DATA_DIR=/app/data
DB_PATH=/app/data/gym.db

# ── Kavenegar SMS ─────────────────────────────────────────────────────────
KAVENEGAR_API_KEY=your_kavenegar_api_key_here
KAVENEGAR_SENDER=20006000853
SMS_SEND_DELAY_MS=400

# ── Optional operational controls ──────────────────────────────────────────
DISABLE_CRON=0
STATIC_DIR=/app/dist

# ── Frontend (local dev only) ─────────────────────────────────────────────
# When running frontend with `npm run dev`, point it to the backend:
# VITE_API_URL=http://localhost:8000
#
# In Docker production build this is left empty so the UI talks to the same origin.
