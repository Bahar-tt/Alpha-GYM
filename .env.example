# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── Persistent storage (must match volume mount path) ─────────────────────
# On Cloudflare / Railway / Docker: mount the disk to /app/data
DATA_DIR=/app/data
DB_PATH=/app/data/gym.db

# ── Kavenegar SMS ─────────────────────────────────────────────────────────
KAVENEGAR_API_KEY=your_kavenegar_api_key_here
KAVENEGAR_SENDER=20006000853
SMS_SEND_DELAY_MS=400

# ── Frontend (local dev only) ─────────────────────────────────────────────
# When running frontend with `npm run dev`, point it to the backend:
# VITE_API_URL=http://localhost:8000
#
# In Docker production build this is left empty so the UI talks to the same origin.
